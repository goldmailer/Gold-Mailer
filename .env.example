# Server
DATABASE_URL=postgresql://user:password@host:5432/database
PORT=5000
SESSION_SECRET=replace-with-a-long-random-value

# Admin access (never commit the real password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-in-deployment-secrets

# Payments (server-only; never use VITE_ for these)
NOWPAYMENTS_API_KEY=replace-in-deployment-secrets
NOWPAYMENTS_IPN_SECRET=replace-in-deployment-secrets

# Email
RESEND_API_KEY=replace-in-deployment-secrets
FROM_EMAIL=noreply@example.com

# Monetag zones (public frontend configuration; replace in Render)
VITE_MONETAG_ZONE_HERO=replace-zone-id
VITE_MONETAG_ZONE_FOOTER=replace-zone-id
VITE_MONETAG_ZONE_FEED=replace-zone-id
VITE_MONETAG_ZONE_SIDEBAR=replace-zone-id
VITE_MONETAG_ZONE_DASHBOARD=replace-zone-id
VITE_MONETAG_ZONE_POPUNDER=replace-zone-id