{
  "name": "goldmailer",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @workspace/gold-mailer run build && pnpm --filter @workspace/api-server run build",
    "start": "node artifacts/api-server/dist/index.mjs",
    "dev:api": "PORT=8080 pnpm --filter @workspace/api-server run dev",
    "dev:web": "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/gold-mailer run dev",
    "typecheck": "tsc --build && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "db:push": "pnpm --filter @workspace/db run push"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1",
    "drizzle-kit": "^0.20.14"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
